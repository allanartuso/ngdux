      },
      "configurations": {
        "production": {
          "tsConfig": "libs/ngil/ui/common/form-cva/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "libs/ngil/ui/common/form-cva/tsconfig.lib.json"
        }
      }
    }
  }
}

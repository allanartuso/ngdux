{
  "name": "ngdux",
  "version": "6.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "nx",
    "nx": "nx",
    "start": "nx serve demo",
    "build": "nx build demo",
    "test": "nx run-many --all --target=test",
    "lint": "nx run-many --all --target=lint",
    "e2e": "nx e2e demo-e2e",
    "e2e:demo:local": "ts-node -P tools/tsconfig.json ./tools/e2e/cy-integration-local.ts && npx cypress run -P ./apps/demo-e2e --headless --config-file=cypress-integration-local.config.ts",
    "e2e:demo:watch": "npx cypress open -P ./apps/demo-e2e",
    "test:ci": " npx jest --ci",
    "affected:apps": "nx show projects --affected --type=app",
    "affected:libs": "nx show projects --affected --type=lib",
    "affected:build": "nx affected --target=build",
    "affected:e2e": "nx affected --target=e2e",
    "affected:test": "nx affected --target=test",
    "affected:lint": "nx affected --target=lint",
    "affected:dep-graph": "nx graph --affected",
    "affected": "nx affected",
    "format": "nx format:write",
    "format:write": "nx format:write",
    "format:check": "nx format:check",
    "update": "nx migrate latest",
    "workspace-generator": "nx generate",
    "dep-graph": "nx graph",
    "help": "nx help",
    "ngdux:build": "nx build ngdux-util-store-form --configuration=production && nx build ngdux-util-store-list --configuration=production",
    "ngdux:publish": "npm publish dist/libs/ngdux/data-model/common && npm publish dist/libs/ngdux/util/store/common && npm publish dist/libs/ngdux/util/store/form && npm publish dist/libs/ngdux/util/store/list",
    "ngil:build": "nx build ngil-ui-common-form-cva --configuration=production && nx build ngil-ui-list --configuration=production && nx build ngil-ui-form-inputs --configuration=production",
    "ngil:publish": "npm publish dist/libs/ngil/ui/common/form-cva && npm publish dist/libs/ngil/ui/list && npm publish dist/libs/ngil/ui/form-inputs",
    "update-versions": "ts-node -P tools/tsconfig.json tools/versioning/update-versions.ts",
    "publish": "ts-node -P tools/tsconfig.json tools/versioning/publish-libs.ts",
    "generate:db": "ts-node -P tools/tsconfig.json tools/generators/db-json.ts",
    "postinstall": "patch-package"
  },

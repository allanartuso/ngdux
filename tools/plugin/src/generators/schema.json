{
  "$schema": "https://json-schema.org/schema",
  "$id": "DemoLib",
  "title": "",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Library name",
      "$default": {
        "$source": "argv",
        "index": 0
      },
      "x-prompt": "What name would you like to use?"
    },
    "scope": {
      "type": "string",
      "description": "Library scope",
      "$default": {
        "$source": "argv",
        "index": 1
      },
      "x-prompt": "Enter the library scope"
    },
    "type": {
      "type": "string",
      "description": "Library type",
      "$default": {
        "$source": "argv",
        "index": 2
      },
      "x-prompt": {
        "message": "Select the type of library",
        "type": "list",
        "items": [
          {
            "value": "feature",
            "label": "Feature Library"
          },
          {
            "value": "data-access",
            "label": "Data Access Library"
          },
          {
            "value": "ui",
            "label": "UI Library"
          },
          {
            "value": "data-model",
            "label": "Data Model Library"
          },
          {
            "value": "util",
            "label": "Utility Library"
          }
        ]
      }
    },
    "unitTestRunner": {
      "type": "string",
      "description": "Unit test runner",
      "$default": {
        "$source": "argv",
        "index": 3
      },
      "x-prompt": {
        "message": "Select the unit test runner",
        "type": "list",
        "items": [
          {
            "value": "jest",
            "label": "Jest"
          },
          {
            "value": "vitest-angular",
            "label": "Vitest Angular"
          },
          {
            "value": "vitest-analog",
            "label": "Vitest Analog"
          },
          {
            "value": "none",
            "label": "None"
          }
        ]
      }
    },
    "publishable": {
      "type": "boolean",
      "description": "Whether the library is publishable",
      "default": false,
      "x-prompt": "Is this library publishable?"
    },
    "isCommon": {
      "type": "boolean",
      "description": "Whether the library is a common library",
      "default": false,
      "x-prompt": "Is this a common library?"
    }
  },
  "required": ["name", "scope", "type", "unitTestRunner"]
}
